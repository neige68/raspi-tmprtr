DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/dbname
TOTP_SECRET=your-base32-secret-here

# Slack 通知（monitor.py / daily_report.py で使用）
SLACK_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#your-channel-name
#
# DB を作るには?
#
# まず MariaDB で DB とユーザーを作成する（DATABASE_URL の内容に合わせて変更）:
#   sudo mariadb -u root
#   CREATE DATABASE dbname CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'user'@'localhost' IDENTIFIED BY 'pass';
#   GRANT ALL PRIVILEGES ON dbname.* TO 'user'@'localhost';
#   FLUSH PRIVILEGES;
#   EXIT;
#
# 次にテーブル作成 + 初期データ投入:
#   uv run python init_db.py
#
# TOTP_SECRET はどうやって作る?
#
# このディレクトリで以下を実行
#   uv run python -c "import pyotp; print(pyotp.random_base32())"
# 出力された Base32 文字列（例: JBSWY3DPEHPK3PXP）を server/.env の TOTP_SECRET= に設定します。
# raspi 側の client でも同じシークレットを使う必要があります。
#
